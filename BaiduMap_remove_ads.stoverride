# 由 Loon 插件移植：百度地图去广告
# 上游：https://raw.githubusercontent.com/mihoyo-typ/KeleeOne/Loon/Plugin/BaiduMap_remove_ads.lpx
# 转换脚本：update-from-lpx.js（重新运行即可跟随上游更新）

#!name=百度地图去广告
#!desc=移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。（Stash 移植版）
#!author=可莉🅥[https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c]
#!homepage=https://getupnote.com/share/notes/zSn1ShBmzNYISKcTgjXE5oHMrNf2/34bf3aad-7872-497d-b239-198e27e8c84c
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/BaiduMap.png
#!tag=去广告
#!date=2025-05-13 15:17:08

name: '百度地图去广告'
desc: '移除开屏广告、出行页面推广、周边页面推广、打车页面推广，精简我的页面。此插件需要IPA签名方可使用，App Store用户请勿使用此插件，务必点击下方主页链接查看详细教程。（Stash 移植版）'

http:
  mitm:
    - afd.baidu.com
    - newclient.map.baidu.com
    - yongche.baidu.com
    - ecom.map.baidu.com
    - maphotel.baidu.com

  # Loon [Rewrite] reject-dict / reject --→ Stash url-rewrite
  url-rewrite:
    - ^https:\/\/afd\.baidu\.com\/afd\/entry\?action=(update|query) - reject-dict
    - ^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$ - reject-dict
    - ^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\? - reject-dict
    - ^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$ - reject-dict
    - ^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$ - reject-dict
    - ^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\? - reject-dict
    - ^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\? - reject-dict

  # Loon response-body-json-del / -replace --→ Stash body-rewrite (response-jq)
  body-rewrite:
    - '^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content response-jq del(.data)'
    - '^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\? response-jq del(.content.multi_data)'
    - '^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\? response-jq .data = {}'
    - '^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?qt=ads&type=user_home_new_service response-jq del(.ads)'
    - '^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? response-jq del(.Result.cards[1], .Result.cards[4], .Result.cards[5], .Result.cards[9])'
